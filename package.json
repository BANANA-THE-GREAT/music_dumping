{
  "name": "vocal-score-studio-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vocal-score/web",
    "build": "npm run build --workspace @vocal-score/web",
    "test": "npm run test --workspace @vocal-score/web",
    "contracts:generate": "python scripts/export-openapi.py",
    "dev:web": "npm run dev --workspace @vocal-score/web",
    "dev:api": "python -m uvicorn app.main:app --reload --app-dir apps/api"
  }
}
