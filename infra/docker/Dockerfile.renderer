FROM python:3.11.16-slim-trixie
RUN apt-get update \
    && apt-get install -y --no-install-recommends inkscape fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir verovio==6.2.1
WORKDIR /app
COPY services/score-renderer/server.py /app/server.py
EXPOSE 8090
CMD ["python", "/app/server.py"]
