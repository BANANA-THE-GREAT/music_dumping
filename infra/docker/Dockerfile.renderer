# syntax=docker/dockerfile:1.7
ARG VSS_RENDERER_BASE_IMAGE=python:3.11.16-slim-trixie
FROM ${VSS_RENDERER_BASE_IMAGE}
ARG VSS_DEBIAN_MIRROR=http://deb.debian.org/debian
ARG VSS_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
RUN sed -i \
      -e "s|URIs: http://deb.debian.org/debian-security|URIs: ${VSS_DEBIAN_SECURITY_MIRROR}|" \
      -e "s|URIs: http://deb.debian.org/debian|URIs: ${VSS_DEBIAN_MIRROR}|" \
      /etc/apt/sources.list.d/debian.sources
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends inkscape fonts-noto-cjk
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install verovio==6.2.1
WORKDIR /app
COPY services/score-renderer/server.py /app/server.py
EXPOSE 8090
CMD ["python", "/app/server.py"]
