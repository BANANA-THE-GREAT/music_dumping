ARG WORKER_DEPENDENCY_IMAGE=vocal-score-studio-worker-deps:local
FROM ${WORKER_DEPENDENCY_IMAGE}
WORKDIR /app
ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
COPY pyproject.toml ./
COPY apps/api apps/api
COPY workers/transcription workers/transcription
RUN pip install --no-cache-dir --no-deps --no-build-isolation .
CMD ["python", "-m", "celery", "-A", "vss_worker.celery_app:celery_app", "worker", "--loglevel=INFO", "--concurrency=1"]
