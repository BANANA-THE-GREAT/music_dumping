FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml ./
RUN pip install --no-cache-dir .
COPY apps/api apps/api
COPY workers/transcription workers/transcription
ENV PYTHONPATH=/app/apps/api:/app/workers/transcription
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
